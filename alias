# claude code
function claude-code() {
  local work_dir
  local -a extra_mounts=()
  local -a pass_args=()

  work_dir="$(pwd)"

  # Parse arguments - extract mount flags and pass through the rest
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --add-dir)
        if [[ -n "$2" ]]; then
          extra_mounts+=("$2")
          shift 2
        else
          echo "Error: --add-dir requires a path argument" >&2
          return 1
        fi
        ;;
      --add-dirs)
        if [[ -n "$2" ]]; then
          local dir
          local -a parsed_dirs=()
          IFS=, read -r -a parsed_dirs <<< "$2"
          for dir in "${parsed_dirs[@]}"; do
            if [[ -n "$dir" ]]; then
              extra_mounts+=("$dir")
            fi
          done
          shift 2
        else
          echo "Error: --add-dirs requires a comma-separated path argument" >&2
          return 1
        fi
        ;;
      *)
        pass_args+=("$1")
        shift
        ;;
    esac
  done

  # Build volume mount arguments
  local -a volume_args=(
    -v "${HOME}/.claude:${HOME}/.claude:rw"
    -v "${HOME}/.claude.json:${HOME}/.claude.json:rw"
    -v "${HOME}/CLAUDE.md:${HOME}/CLAUDE.md:rw"
    -v "/var/run/docker.sock:/var/run/docker.sock"
    -v "${HOME}/.gitconfig:${HOME}/.gitconfig:ro"
    -v "${HOME}/.ssh:${HOME}/.ssh:ro"
  )

  # Add git credentials if they exist
  if [[ -f "${HOME}/.git-credentials" ]]; then
    volume_args+=(-v "${HOME}/.git-credentials:${HOME}/.git-credentials:ro")
  fi

  # Add extra mounts
  for dir in "${extra_mounts[@]}"; do
    volume_args+=(-v "$dir":"$dir":rw)
  done

  docker run --rm -it \
    "${volume_args[@]}" \
    -w "${work_dir}" \
    -e USER="${USER}" \
    -e HOME="${HOME}" \
    --group-add "$(getent group docker | cut -d: -f3)" \
    --user "${UID}:${UID}" \
    claude-code claude --allow-dangerously-skip-permissions --permission-mode plan "${pass_args[@]}"
}
